---
import { BookOpenIcon, FileTextIcon, GlobeIcon } from '@lucide/vue'
import { FORMAT_GROUPS, FORMAT_NOTE } from '@/lib/formats'

const icons = {
  comic: BookOpenIcon,
  ebook: FileTextIcon,
  online: GlobeIcon,
}
---

<section id="formats" class="section border-y border-border bg-card" aria-labelledby="formats-title">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">格式支持</p>
      <h2 id="formats-title" class="section-title mt-2">九类格式，打开就能读</h2>
      <p class="section-desc">
        漫画与电子书走各自的读取器，在线书源走规则引擎；全部由原生代码或 macOS 自带工具完成。
      </p>
    </div>

    <div class="reveal mt-8 grid gap-4 lg:grid-cols-3">
      {
        FORMAT_GROUPS.map((group) => {
          const Icon = icons[group.icon]
          return (
            <article class="card-surface flex flex-col p-5">
              <div class="flex items-center gap-2.5">
                <span class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <Icon class="size-4" />
                </span>
                <h3 class="text-base font-medium">{group.label}</h3>
              </div>

              <ul class="mt-4 flex flex-wrap gap-1.5">
                {group.formats.map((format) => (
                  <li class="rounded-full border border-border bg-background px-2.5 py-1 font-mono text-xs text-muted-foreground">
                    {format}
                  </li>
                ))}
              </ul>

              <p class="mt-auto pt-4 text-xs leading-relaxed text-muted-foreground">
                <span class="font-medium text-foreground">读取方式：</span>
                {group.reader}
              </p>
            </article>
          )
        })
      }
    </div>

    <p class="reveal mt-5 text-center text-xs leading-relaxed text-muted-foreground">
      {FORMAT_NOTE} 除 Sparkle 外没有别的第三方依赖。
    </p>
  </div>
</section>
